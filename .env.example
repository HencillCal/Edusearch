# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
DATA_DIR=./data
MAX_UPLOAD_BYTES=52428800
FIRST_USER_ADMIN=true
# COOKIE_SECURE=auto  # auto, true or false
OCR_LANGUAGE=eng+swa
OCR_DEFAULT_PROFILE=exam
OCR_DEFAULT_QUALITY_MODE=accurate
OCR_MAX_PAGES=40
OCR_PAGE_TIMEOUT_MS=180000
OCR_ENSEMBLE_SCORE_DELTA=18
# Recommended for photographed pages: perspective correction and uneven-light normalization.
OCR_OPENCV_PREPROCESS=true
OCR_DEWARP_MIN_CONFIDENCE=0.52
OCR_PREPROCESS_TIMEOUT_MS=45000
OCR_LAYOUT_ANALYSIS_TIMEOUT_MS=30000
OCR_BLUR_REVIEW_THRESHOLD=0.58
OCR_HANDWRITING_REVIEW_THRESHOLD=0.56

# ── OCR Vision Fallback ──────────────────────────────────────────────────────
# Optional. Used only for uncertain/formula-heavy/corrupted lines after Tesseract.
# Pick ONE provider. Same OpenAI-compatible interface as the AI section above.
#
# ── OpenAI GPT-4o vision ─────────────────────────────────────────────────────
# OCR_VISION_BASE_URL=https://api.openai.com/v1
# OCR_VISION_API_KEY=sk-...
# OCR_VISION_MODEL=gpt-4o-mini
#
# ── Google Gemini vision ─────────────────────────────────────────────────────
# OCR_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OCR_VISION_API_KEY=AIza...
# OCR_VISION_MODEL=gemini-2.0-flash
#
# ── xAI Grok vision ──────────────────────────────────────────────────────────
# OCR_VISION_BASE_URL=https://api.x.ai/v1
# OCR_VISION_API_KEY=xai-...
# OCR_VISION_MODEL=grok-2-vision-1212
#
# ── Ollama local vision (free) ────────────────────────────────────────────────
# OCR_VISION_BASE_URL=http://localhost:11434/v1
# OCR_VISION_API_KEY=ollama
# OCR_VISION_MODEL=qwen2.5-vl:7b
#
OCR_VISION_MAX_LINES=8
OCR_VISION_TIMEOUT_MS=30000


# Optional academic vocabulary files. Put one accepted OCR term/pattern on each line.
# OCR_USER_WORDS_PATH=./data/ocr-user-words.txt
# OCR_USER_PATTERNS_PATH=./data/ocr-user-patterns.txt
AUTO_OCR_SCANNED_PDF=true
# Set true only when you want to ignore an existing PDF text layer and OCR its page images.
OCR_FORCE_IMAGE=false

# Optional ClamAV service (enabled automatically in docker-compose)
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ── AI Metadata Classifier ───────────────────────────────────────────────────
# Used for: document title/subject/topic suggestions during upload and OCR.
# Pick ONE provider below. Uncomment its block and fill in your API key.
# The app uses a single OpenAI-compatible interface — all providers work the
# same way; just swap the base URL, key, and model name.
#
# ── Option 1: OpenAI ─────────────────────────────────────────────────────────
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...                        # https://platform.openai.com/api-keys
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small
#
# ── Option 2: Google Gemini (OpenAI-compatible endpoint) ─────────────────────
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=AIza...                       # https://aistudio.google.com/apikey
# AI_CHAT_MODEL=gemini-2.0-flash
# AI_EMBEDDING_MODEL=text-embedding-004
#
# ── Option 3: xAI Grok ───────────────────────────────────────────────────────
# AI_BASE_URL=https://api.x.ai/v1
# AI_API_KEY=xai-...                       # https://console.x.ai
# AI_CHAT_MODEL=grok-3-mini
# AI_EMBEDDING_MODEL=
#
# ── Option 4: Anthropic Claude (via OpenAI-compatible proxy) ─────────────────
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_API_KEY=sk-ant-...                    # https://console.anthropic.com/keys
# AI_CHAT_MODEL=claude-3-5-haiku-20241022
# AI_EMBEDDING_MODEL=
#
# ── Option 5: Ollama (local, free) ───────────────────────────────────────────
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama                        # any non-empty string works
# AI_CHAT_MODEL=qwen2.5:7b-instruct
# AI_EMBEDDING_MODEL=nomic-embed-text
#
# ── Option 6: OpenRouter (access 100+ models via one key) ────────────────────
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...                     # https://openrouter.ai/keys
# AI_CHAT_MODEL=google/gemini-flash-1.5
# AI_EMBEDDING_MODEL=
