# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
DATA_DIR=./data
MAX_UPLOAD_BYTES=52428800
FIRST_USER_ADMIN=true
# COOKIE_SECURE=auto  # auto, true or false
OCR_LANGUAGE=eng+swa
OCR_DEFAULT_PROFILE=exam
OCR_DEFAULT_QUALITY_MODE=accurate
OCR_MAX_PAGES=40
OCR_PAGE_TIMEOUT_MS=180000
OCR_ENSEMBLE_SCORE_DELTA=18
# Recommended for photographed pages: perspective correction and uneven-light normalization.
OCR_OPENCV_PREPROCESS=true
OCR_DEWARP_MIN_CONFIDENCE=0.52
OCR_PREPROCESS_TIMEOUT_MS=45000
OCR_LAYOUT_ANALYSIS_TIMEOUT_MS=30000
OCR_BLUR_REVIEW_THRESHOLD=0.58
OCR_HANDWRITING_REVIEW_THRESHOLD=0.56

# Optional OpenAI-compatible vision endpoint. Used only for uncertain, formula-heavy or corrupted lines.
# OCR_VISION_BASE_URL=http://localhost:11434/v1
# OCR_VISION_API_KEY=
# OCR_VISION_MODEL=qwen2.5-vl:7b
OCR_VISION_MAX_LINES=8
OCR_VISION_TIMEOUT_MS=30000

# Optional academic vocabulary files. Put one accepted OCR term/pattern on each line.
# OCR_USER_WORDS_PATH=./data/ocr-user-words.txt
# OCR_USER_PATTERNS_PATH=./data/ocr-user-patterns.txt
AUTO_OCR_SCANNED_PDF=true
# Set true only when you want to ignore an existing PDF text layer and OCR its page images.
OCR_FORCE_IMAGE=false

# Optional ClamAV service (enabled automatically in docker-compose)
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# Optional OpenAI-compatible metadata classifier.
# Works with an OpenAI-compatible server or a local gateway such as Ollama through a compatible endpoint.
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_CHAT_MODEL=qwen2.5:7b-instruct
# AI_EMBEDDING_MODEL=nomic-embed-text
